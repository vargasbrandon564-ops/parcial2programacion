# Variables de entorno para producción en Render

# DEBUG (en producción debe ser False)
DEBUG=False

# ALLOWED_HOSTS (separados por comas)
ALLOWED_HOSTS=tu-app.onrender.com,localhost

# Database (Render proporciona estas automáticamente)
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGHOST=
# PGPORT=

# Email (configurar con tu cuenta de Gmail o SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
DEFAULT_FROM_EMAIL=tu-email@gmail.com

# Security
SECRET_KEY=tu-secret-key-segura-aqui
